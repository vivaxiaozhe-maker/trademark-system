{
  "name": "trademark-management-system",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server/index.ts",
    "build": "npm run build:server && npm run build:pages",
    "build:server": "tsc -p tsconfig.json",
    "build:pages": "node scripts/build-pages.mjs",
    "check:pages": "node scripts/check-pages.mjs",
    "start": "node dist/server/index.js",
    "migrate": "tsx src/server/cli.ts migrate",
    "seed:demo": "tsx src/server/cli.ts seed:demo",
    "reset:demo": "tsx src/server/cli.ts reset:demo",
    "workspace:create": "tsx src/server/cli.ts workspace:create",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test tests/*.test.ts tests/*.test.cjs"
  },
  "dependencies": {
    "fastify": "^5.6.1",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/pg": "^8.15.6",
    "pg-mem": "^3.0.5",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
